{
	"name": "obsidian-extension-watcher",
	"version": "1.0.1",
	"description": "Monitor de atividades de extensões do Obsidian que rastreia arquivos acessados, comandos executados e chamadas de rede",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"test:ci": "jest --ci --coverage --reporters=default",
		"release": "yarn test && yarn build"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"monitoring",
		"security",
		"debugging"
	],
	"author": "Diego RV",
	"license": "MIT",
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^22.15.30",
		"builtin-modules": "^5.0.0",
		"esbuild": "^0.25.10",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"obsidian": "latest",
		"ts-jest": "^29.4.0",
		"tslib": "^2.8.1",
		"typescript": "^5.9.2"
	}
}
